# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key both work here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Numerical answers stored as a single value are accepted within ± this percent.
NEXT_PUBLIC_NUMERIC_TOLERANCE_PCT=1

# Phase 2+. Server-side only — never prefix with NEXT_PUBLIC_.
# Gemini finds where each question is on the page (aistudio.google.com → Get API key).
GEMINI_API_KEY=
GEMINI_LAYOUT_MODEL=gemini-3.5-flash
# Groq reads each question's text and options from its crop.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Supabase → Project Settings → API → service_role key.
# Used only by app/api/pages/[pageId]/segment/route.ts to read/update a page
# across the AI queue; every query still filters by user_id explicitly, since
# this key bypasses Row Level Security entirely. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
