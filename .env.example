# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key both work here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Numerical answers stored as a single value are accepted within ± this percent.
NEXT_PUBLIC_NUMERIC_TOLERANCE_PCT=1

# Phase 2+ (not used yet). Server-side only — never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
